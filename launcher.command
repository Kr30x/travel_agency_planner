#!/bin/bash

# ═══════════════════════════════════════════════════════════
#  🏨 ЗАПУСК HOTEL PLANNER
#  Положи этот файл на рабочий стол и дважды кликай по нему!
# ═══════════════════════════════════════════════════════════

# НАСТРОЙКА: Укажи путь к папке с приложением
APP_PATH="/$HOME/travel_agency_planner"

# ═══════════════════════════════════════════════════════════

clear
echo "═══════════════════════════════════════════════════════════"
echo "  🏨 HOTEL PLANNER - ПЛАНИРОВЩИК РАЗМЕЩЕНИЯ"
echo "═══════════════════════════════════════════════════════════"
echo ""

# Проверка что папка существует
if [ ! -d "$APP_PATH" ]; then
    echo "❌ ОШИБКА: Папка не найдена!"
    echo ""
    echo "Ожидаемый путь: $APP_PATH"
    echo ""
    echo "Пожалуйста:"
    echo "1. Убедись что папка скопирована в правильное место"
    echo "2. ИЛИ измени путь в начале этого файла (открой в текстовом редакторе)"
    echo ""
    echo "Нажми любую клавишу для выхода..."
    read -n 1
    exit 1
fi

# Переходим в папку приложения
cd "$APP_PATH"

# Проверка Python
if ! command -v python3 &> /dev/null; then
    echo "❌ ОШИБКА: Python 3 не найден!"
    echo ""
    echo "Пожалуйста, установи Python 3.8 или выше с сайта:"
    echo "https://www.python.org/downloads/"
    echo ""
    echo "Нажми любую клавишу для выхода..."
    read -n 1
    exit 1
fi

echo "✓ Python найден: $(python3 --version)"
echo ""

# Проверка установлены ли зависимости
VENV_MARKER="$APP_PATH/.installed"

if [ ! -f "$VENV_MARKER" ]; then
    echo "📦 Первый запуск - устанавливаю необходимые компоненты..."
    echo "   (это займёт около минуты)"
    echo ""
    
    pip3 install -r requirements.txt --quiet
    
    if [ $? -eq 0 ]; then
        echo "✓ Компоненты установлены!"
        touch "$VENV_MARKER"
        echo ""
    else
        echo "❌ Ошибка установки компонентов"
        echo ""
        echo "Нажми любую клавишу для выхода..."
        read -n 1
        exit 1
    fi
fi

echo "🚀 Запускаю приложение..."
echo ""
echo "📍 Браузер откроется автоматически через 3 секунды"
echo "📍 Адрес: http://localhost:5001"
echo ""
echo "───────────────────────────────────────────────────────────"
echo ""
echo "💡 Для остановки закрой это окно или нажми Ctrl+C"
echo ""
echo "═══════════════════════════════════════════════════════════"
echo ""

# Открываем браузер через 3 секунды (в фоне)
(sleep 3 && open http://localhost:5001 2>/dev/null || xdg-open http://localhost:5001 2>/dev/null) &

# Запуск приложения
python3 app.py

# После завершения
echo ""
echo "Приложение остановлено. Окно можно закрыть."
echo ""
read -n 1 -p "Нажми любую клавишу для выхода..."
